# Copy this file to .env and fill in real values. Never commit .env.

# ── Which network ────────────────────────────────────────────────────────
# "testnet" or "mainnet". Controls which RPC/chainId/explorer agent/network.js
# resolves to, and which deployments/<network>.json file the agent + dashboard read.
# Defaults to "testnet" if unset — deliberately, so a fresh checkout can't
# accidentally fire a transaction at mainnet before you've opted in.
NETWORK=testnet

# ── Deployment ───────────────────────────────────────────────────────────
# Private key of the wallet that deploys ReceiptLedger and pays gas, on whichever
# network NETWORK selects. Testnet BOT: https://faucet.botchain.ai/basic (free).
# Mainnet BOT: https://dex.botchain.ai (no faucet — swap for it).
DEPLOYER_PRIVATE_KEY=

# Optional overrides — defaults in agent/network.js already point at the real
# BOT Chain mainnet/testnet RPCs, verified live.
BOTCHAIN_RPC_URL=
BOTCHAIN_TESTNET_RPC_URL=
BOTCHAIN_EXPLORER_API_URL=https://api-scan.botchain.ai/api
BOTCHAIN_EXPLORER_API_KEY=
BOTCHAIN_TESTNET_EXPLORER_API_URL=https://api-scan.bohr.life/api
BOTCHAIN_TESTNET_EXPLORER_API_KEY=

# Who gets DEFAULT_ADMIN_ROLE (pause/unpause, tune limits). Use a multisig if you have
# one; defaults to the deployer address if left blank.
ADMIN_ADDRESS=

# Who gets AGENT_ROLE (the wallet the WhatsApp agent signs receipt txs with). Can be a
# separate, less-privileged wallet than the deployer — recommended. Defaults to the
# deployer address if left blank.
AGENT_ADDRESS=

# ── WhatsApp agent runtime ───────────────────────────────────────────────
# Private key the running agent process uses to SEND issueReceipt transactions.
# Should correspond to AGENT_ADDRESS above. Keep this on the machine running the
# agent only — never share it, never commit it.
AGENT_PRIVATE_KEY=

# Used to parse free-text WhatsApp messages into structured sale data and run the
# pre-attestation fraud/anomaly check. agent/llmParser.js picks whichever is set —
# GROQ_API_KEY takes priority if both are present.
# GROQ_API_KEY: free, no card required. Get one at console.groq.com.
# ANTHROPIC_API_KEY: paid, requires billing set up at console.anthropic.com.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Secret pepper mixed into every phone-number hash before it touches the chain, so raw
# numbers can never be recovered by brute-forcing/rainbow-tabling public merchantHash /
# buyerHash values on-chain. Generate a long random string and never reuse it elsewhere.
PHONE_HASH_SALT=

# ── Lender dashboard (server.js) ─────────────────────────────────────────
# Port the read-only dashboard listens on.
DASHBOARD_PORT=4000

# Base URL the WhatsApp agent embeds in "share your Credora ID" replies. Defaults to
# localhost for local demos — point this at a public URL (e.g. an ngrok tunnel, or a
# real deploy) once the dashboard needs to be reachable by an actual lender.
DASHBOARD_BASE_URL=http://localhost:4000

# Optional: pin the dashboard/agent to a specific contract address instead of reading
# deployments/<network>.json (useful if you deploy from a different machine than the
# one running the agent/dashboard).
CONTRACT_ADDRESS=
